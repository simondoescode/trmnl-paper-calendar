{
  "name": "TRMNL Paper Calendar",
  "image": "trmnl/trmnlp",
  "workspaceFolder": "/plugin",
  "workspaceMount": "source=${localWorkspaceFolder},target=/plugin,type=bind",
  "forwardPorts": [4567],
  "postStartCommand": "trmnlp serve --bind 0.0.0.0 > /tmp/trmnlp.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.theme-check-vscode",
        "redhat.vscode-yaml"
      ]
    }
  }
}
