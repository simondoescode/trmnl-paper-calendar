{
  "name": "TRMNL Paper Calendar",
  "dockerComposeFile": ["../compose.yaml", "compose.devcontainer.yaml"],
  "service": "renderer",
  "runServices": ["renderer", "preview"],
  "workspaceFolder": "/plugin",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "forwardPorts": ["preview:8080"],
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.theme-check-vscode",
        "redhat.vscode-yaml"
      ]
    }
  }
}
